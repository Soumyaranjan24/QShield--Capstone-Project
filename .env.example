# QShield local Docker development settings.
# Copy to .env, then replace the development-only secrets before using the app.
NODE_ENV=development

# These three PostgreSQL values must stay in sync with DATABASE_URL.
POSTGRES_DB=pqc_assistant
POSTGRES_USER=pqc_app
POSTGRES_PASSWORD=local-only-change-this-password
DATABASE_URL=postgresql://pqc_app:local-only-change-this-password@postgres:5432/pqc_assistant

# Local development secrets only. Generate unique random values for deployment.
JWT_SECRET=local-development-only-change-this-jwt-secret-before-deploying
ANALYZER_SHARED_TOKEN=local-development-only-change-this-analyzer-token

# Browser and upload settings.
CORS_ORIGIN=http://localhost:5173
VITE_APP_NAME=QShield
VITE_API_URL=http://localhost:8000/api
MAX_UPLOAD_MB=100

# Production reference only: docker-compose.yml is for local development and still
# starts its bundled PostgreSQL container. Use a production deployment config that
# omits that service and injects secrets through the hosting provider.
# - Store production secrets in the hosting provider's secret manager; never commit them.
# - Set DATABASE_URL to the managed PostgreSQL connection string (for example, Supabase).
# - Use the provider's direct or session-pooler connection as appropriate, with SSL enabled.
# - Set CORS_ORIGIN and VITE_API_URL to the deployed app/API HTTPS origins.
